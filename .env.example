# ===== LLM =====
# provider=mock 时使用确定性回退（无需 Key，整条链路仍真实执行）
RECRUITER_LLM_PROVIDER=mock
RECRUITER_LLM_MODEL=gpt-4o-mini
# 任意 OpenAI 兼容端点：OpenAI / DeepSeek / 通义 / vLLM / Ollama
RECRUITER_LLM_BASE_URL=
RECRUITER_LLM_API_KEY=
RECRUITER_LLM_TEMPERATURE=0.1

# ===== Embedding =====
# hash | sentence_transformers | openai
RECRUITER_EMBEDDING_PROVIDER=hash
RECRUITER_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RECRUITER_EMBEDDING_DIM=384

# ===== Rerank =====
# rrf | cross_encoder | llm
RECRUITER_RERANK_PROVIDER=rrf
RECRUITER_RERANK_MODEL=BAAI/bge-reranker-base
RECRUITER_RRF_K=60

# ===== 向量库 =====
# auto | elasticsearch | milvus | memory
RECRUITER_VECTOR_STORE_BACKEND=auto
RECRUITER_ES_URL=http://localhost:9200
RECRUITER_ES_INDEX_CANDIDATES=recruit_candidates_v1
RECRUITER_ES_INDEX_KNOWLEDGE=recruit_knowledge_v1
RECRUITER_MILVUS_URI=http://localhost:19530
RECRUITER_MILVUS_DB=recruit

# ===== 编排 =====
RECRUITER_MAX_REFLECTION_ROUNDS=2
RECRUITER_RETRIEVAL_TOP_K=30
RECRUITER_RERANK_TOP_N=5
RECRUITER_PASS_SCORE=60
